#!/bin/bash
# Turns the Raspberry Pi into a WiFi access point (10.3.141.1) for the remote. Safe to run again.
# Bookworm: NetworkManager hotspot. Bullseye: hostapd.

# Get variables
while true; do
  echo -n "Please provide a SSID name: "
  read your_SSID < /dev/tty
  [ -n "$your_SSID" ] && break
done

while true; do
  echo -n "Please provide a password (8 - 63 characters): "
  read your_PASS < /dev/tty
  [ ${#your_PASS} -ge 8 ] && [ ${#your_PASS} -le 63 ] && break
  echo "The password must be 8 to 63 characters long."
done

while true; do
  echo -n "Please provide a WiFi Channel (1 - 6 - 13): "
  read your_CHANNEL < /dev/tty
  [[ "$your_CHANNEL" =~ ^([1-9]|1[0-3])$ ]] && break
  echo "The channel must be a number from 1 to 13."
done

# Get the version number from the OS release information
VERSION=$(grep -oP '(?<=^VERSION_ID=).+' /etc/os-release | tr -d '"')

case $VERSION in
  12)
    # Undo the settings of older versions of this script, they keep NetworkManager away from wlan0
    sudo rm -f /etc/NetworkManager/conf.d/ignore-wlan0.conf
    if [ -f /etc/network/interfaces ]; then
      sudo sed -i '/^# Loopback interface configuration$/,/^    broadcast 10.3.141.255$/d' /etc/network/interfaces
    fi
    sudo systemctl disable --now hostapd 2>/dev/null || true
    sudo systemctl restart NetworkManager
    sleep 5

    # Create the access point with a fixed address (the remote has a fixed address too, no DHCP needed)
    sudo rfkill unblock wifi
    sudo nmcli connection delete basketclock-ap 2>/dev/null || true
    sudo nmcli connection add type wifi ifname wlan0 con-name basketclock-ap autoconnect yes \
      ssid "$your_SSID" \
      802-11-wireless.mode ap 802-11-wireless.band bg 802-11-wireless.channel "$your_CHANNEL" \
      wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$your_PASS" \
      wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp \
      ipv4.method manual ipv4.addresses 10.3.141.1/24 ipv6.method disabled
    sudo nmcli connection up basketclock-ap
    ;;
  11)
    # Tell dhcpcd to ignore wlan0 (only once)
    if ! grep -q "^denyinterfaces wlan0" /etc/dhcpcd.conf; then
      echo "denyinterfaces wlan0" | sudo tee -a /etc/dhcpcd.conf > /dev/null
    fi
    sudo systemctl restart dhcpcd

    # Fixed address on wlan0 (only once)
    if ! grep -q "address 10.3.141.1" /etc/network/interfaces; then
sudo bash -c 'cat <<EOF >>/etc/network/interfaces
# Loopback interface configuration
auto lo
iface lo inet loopback

# Ethernet interface configuration, set to use DHCP for dynamic IP address assignment
auto eth0
iface eth0 inet dhcp

# Wireless interface configuration, set to use a static IP address
allow-hotplug wlan0
iface wlan0 inet static
    address 10.3.141.1
    netmask 255.255.255.0
    network 10.3.141.0
    broadcast 10.3.141.255
EOF'
    fi

    # Restart the wlan0 interface to apply changes
    sudo ifdown wlan0; sudo ifup wlan0

    # Install the hostapd package to create a wireless access point
    sudo apt-get install hostapd -y

    # Create the hostapd configuration file (values written directly, so special characters are no problem)
    sudo tee /etc/hostapd/hostapd.conf > /dev/null <<EOF
interface=wlan0
driver=nl80211
ssid=$your_SSID
channel=$your_CHANNEL
hw_mode=g
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_passphrase=$your_PASS
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF

    # Enable and start the hostapd service to activate the wireless access point
    sudo systemctl unmask hostapd
    sudo systemctl enable hostapd
    sudo systemctl restart hostapd
    ;;
  *)
    echo "Unsupported version: $VERSION"
    exit 1
    ;;
esac

# Display a message reminding the user to update SSID and PASS in boot.py
echo -e "\033[0;31m************************************************************************\033[m\n\n"
echo -e "\033[0;31m  Make sure to replace _wifi_SSID_ & _wifi_PASS_ in nodemcu/boot.py as well.\033[m\n\n"
echo -e "\033[0;31m************************************************************************\033[m\n\n"
